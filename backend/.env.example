# Server
NODE_ENV=development
PORT=5000

# Local Docker MongoDB (matches ../compose.yaml)
MONGODB_URI=mongodb://derma:derma_local_password@127.0.0.1:27017/?authSource=admin
MONGODB_DB_NAME=derma_app

# Authentication (replace with a long random value outside local development)
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@drsalmanclinic.local
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=Administrator

# Comma-separated frontend origins allowed by CORS
CLIENT_URL=http://localhost:5173

# MongoDB GridFS image storage
GRIDFS_BUCKET=images
MAX_UPLOAD_MB=3
